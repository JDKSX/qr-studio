{
  "name": "qr-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A powerful browser-based QR Code designer for creating beautiful, customizable and high-quality QR Codes.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild tests/probe.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/probe.mjs --log-level=warning && node node_modules/.cache/probe.mjs"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "license": "MIT"
}
